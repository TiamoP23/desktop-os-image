From: TiamoP23 <43099774+TiamoP23@users.noreply.github.com>
Subject: [PATCH] fix: support GNOME Shell 51

Backport the API replacements described in upstream PRs #641 and #658.
Keep compatibility with older supported shells, without taking unrelated
cache or packaging changes from the unmerged pull requests.

https://github.com/Tudmotu/gnome-shell-extension-clipboard-indicator/pull/658

diff --git a/compat.js b/compat.js
new file mode 100644
--- /dev/null
+++ b/compat.js
@@ -0,0 +1,8 @@
+import Clutter from 'gi://Clutter';
+import St from 'gi://St';
+
+export function boxLayoutOrientation(vertical) {
+    return 'orientation' in St.BoxLayout.prototype
+        ? { orientation: vertical ? Clutter.Orientation.VERTICAL : Clutter.Orientation.HORIZONTAL }
+        : { vertical };
+}
