[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['dash-to-panel@jderose9.github.com', 'blur-my-shell@aunetx', 'CoverflowAltTab@palatis.blogspot.com', 'clipboard-indicator@tudmotu.com', 'gsconnect@andyholmes.github.io', 'caffeine@patapon.info', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com', 'add-to-steam@pupper.space', 'bazaar-integration@kolunmi.github.io', 'restartto@tiagoporsch.github.io', 'nextpinp@leonid.nasedkin']
favorite-apps=['org.gnome.Nautilus.desktop', 'app.zen_browser.zen.desktop', 'jetbrains-idea-cf9ac5e4-4365-47a6-a975-35da5da7b280.desktop', 'com.visualstudio.code.desktop']

[org/gnome/desktop/interface]
clock-format='24h'
clock-show-weekday=true
color-scheme='prefer-dark'
enable-hot-corners=false

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
num-workspaces=1

[org/gnome/mutter]
center-new-windows=true
workspaces-only-on-primary=false


[org/gnome/shell/extensions/clipboard-indicator]
display-mode=3
toggle-menu=['<Super>v']

[org/gnome/shell/extensions/coverflowalttab]
bind-to-switch-applications=false
hide-panel=false
switcher-looping-method='Carousel'

[org/gnome/shell/extensions/blur-my-shell]
settings-version=2

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
brightness=0.9
dynamic-opacity=false
opacity=230
whitelist=['org.gnome.*']

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
static-blur=false

[org/gnome/shell/extensions/dash-to-panel]
appicon-margin=4
appicon-padding=6
context-menu-entries='[{"title":"Terminal","cmd":"TERMINALSETTINGS"},{"title":"Files","cmd":"nautilus"}]'
hide-overview-on-startup=true
isolate-workspaces=true
overview-click-to-exit=true
panel-element-positions='{"0":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"centerMonitor"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
trans-panel-opacity=0.0
trans-use-custom-bg=true
trans-use-custom-opacity=true
trans-use-dynamic-opacity=true

[org/gnome/shell/extensions/gsconnect]
enabled=true
name='bazzite'

[org/gnome/shell/extensions/caffeine]
indicator-position-max=2
show-notifications=false

[org/gnome/shell/extensions/user-theme]
name=''

[org/gnome/shell/extensions/add-to-steam]
use-nautilus=false

[org/gnome/shell/extensions/nextpinp]
corner='top-right'
